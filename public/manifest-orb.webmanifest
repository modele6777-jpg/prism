      "purpose": "any maskable"
    },
    {
      "src": "/orb-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon-orb.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/orb-icon.svg",
      "sizes": "any",
