    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "wouter": "^3.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
