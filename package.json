{
  "name": "lucy-universe",
  "private": true,
  "version": "1.2.878",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:full": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:full": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "deploy:firestore-rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.5",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@vitejs/plugin-react": "^6.0.1",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.21",
    "axios": "^1.15.2",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "google-tts-api": "^2.0.2",
    "html-to-image": "^1.11.13",
    "http-proxy-middleware": "^4.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-edge-tts": "^1.2.10",
    "openai": "^6.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-youtube": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
